{
  "name": "Python Labs with LaTeX",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "INSTALL_LATEX": "true"
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "editorconfig.editorconfig",
        "davidanson.vscode-markdownlint",
        "james-yu.latex-workshop"
      ]
    }
  }
}
