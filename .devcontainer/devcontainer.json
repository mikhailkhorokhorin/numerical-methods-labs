{
  "name": "C++ Labs with LaTeX",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "INSTALL_LATEX": "true"
    }
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "editorconfig.editorconfig",
        "davidanson.vscode-markdownlint",
        "charliermarsh.ruff",
        "james-yu.latex-workshop"
      ]
    }
  }
}
