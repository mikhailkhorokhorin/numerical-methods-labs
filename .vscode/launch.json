{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "lab",
      "type": "pickString",
      "description": "Lab",
      "options": [
        "lab1"
      ]
    },
    {
      "id": "app",
      "type": "pickString",
      "description": "Executable",
      "options": [
        "lu",
        "tridiagonal",
        "iterative",
        "rotation",
        "qr"
      ],
      "default": "lu"
    }
  ],
  "configurations": [
    {
      "name": "Debug lab executable",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/${input:lab}/${input:lab}_${input:app}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
