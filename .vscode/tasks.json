{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "lab",
      "type": "pickString",
      "description": "Lab",
      "options": [
        "lab1"
      ]
    },
    {
      "id": "task",
      "type": "pickString",
      "description": "Task",
      "options": [
        "all",
        "task1",
        "task2",
        "task3",
        "task4",
        "task5"
      ],
      "default": "all"
    }
  ],
  "tasks": [
    {
      "label": "Test",
      "type": "shell",
      "command": "make test LAB=${input:lab}",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "make run LAB=${input:lab} TASK=${input:task}",
      "problemMatcher": []
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "make format",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "make lint",
      "problemMatcher": []
    },
    {
      "label": "Coverage",
      "type": "shell",
      "command": "make coverage",
      "problemMatcher": []
    },
    {
      "label": "Report",
      "type": "shell",
      "command": "make report LAB=${input:lab}",
      "problemMatcher": []
    },
    {
      "label": "CI",
      "type": "shell",
      "command": "make ci",
      "problemMatcher": []
    }
  ]
}
